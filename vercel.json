{
  "version": 2,
  "rewrites": [
    {
      "source": "/",
      "destination": "/HTML/index.html"
    },
    {
      "source": "/talentos",
      "destination": "/HTML/talentos.html"
    }
  ],
  "redirects": [
    {
      "source": "/HTML",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/HTML/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/HTML/talentos.html",
      "destination": "/talentos",
      "permanent": true
    }
  ]
}
